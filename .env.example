# Copy this file to .env and fill in your own credentials.
# NEVER commit a real .env file. All values below are placeholders.

# Set to 1 to run with a deterministic mock LLM (no key, no network).
# Used by the test suite. Set to 0 (or remove) for live analysis.
TEST_MODE=0

# --- Primary LLM: NVIDIA hosted API (free prototyping tier) ---
# Key from https://build.nvidia.com (starts with nvapi-).
# Model: nvidia/nemotron-3-ultra-550b-a55b via integrate.api.nvidia.com.
# (deepseek-ai/deepseek-v4.1-flash was the first choice, but a live check
# of GET /v1/models on 18 Nov 2026 showed no DeepSeek model in NVIDIA's
# current catalog, so the strongest available reasoning model is used.)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Fallback LLM: Google Gemini free tier (optional) ---
# Key from Google AI Studio (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
